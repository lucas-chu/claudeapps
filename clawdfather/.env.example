# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Filled in by `python -m scripts.setup` — copy its output here.
ENVIRONMENT_ID=
CLAWDFATHER_AGENT_ID=
CLAWDFATHER_AGENT_VERSION=

# Optional overrides
TEAMMATE_MODEL=claude-opus-5
TEAMMATE_EFFORT=high
GATE_MODEL=claude-haiku-4-5
# Used only to build the Console trace URL printed in logs.
ANTHROPIC_WORKSPACE=default

# ---------------------------------------------------------------------------
# Router app  (the ONE app that receives events — ClawdFather's app)
#   Socket Mode: ON
#   Bot scopes: app_mentions:read, channels:history, channels:read,
#               chat:write, chat:write.customize, users:read,
#               channels:manage  (so it can invite teammates to channels)
#   Event subscriptions: message.channels
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# ---------------------------------------------------------------------------
# Teammate identity pool — 3 pre-created Slack apps.
#   Each needs ONLY: chat:write, chat:write.customize, users.profile:write
#   (no Socket Mode, no event subscriptions — they never listen, only post).
#   Install each to the workspace, then paste its bot token + bot user ID.
#   Find the user ID at api.slack.com/apps -> your app -> App Home.
# ---------------------------------------------------------------------------
SLACK_TEAMMATE_1_BOT_TOKEN=xoxb-...
SLACK_TEAMMATE_1_USER_ID=U...

SLACK_TEAMMATE_2_BOT_TOKEN=xoxb-...
SLACK_TEAMMATE_2_USER_ID=U...

SLACK_TEAMMATE_3_BOT_TOKEN=xoxb-...
SLACK_TEAMMATE_3_USER_ID=U...
