# --- Claude ------------------------------------------------------------------
# The only Claude credential you need. The Agent SDK drives a Claude Code CLI
# that ships inside the pip package - nothing to install separately.
ANTHROPIC_API_KEY=sk-ant-...

CHECKCLAUDE_MODEL=claude-opus-5
CHECKCLAUDE_EFFORT=high
CHECKCLAUDE_MAX_TURNS=40

# Fan out one investigator subagent per sub-claim. "false" runs the older
# single-agent path: cheaper and quicker, weaker on multi-part claims.
CHECKCLAUDE_FANOUT=true
CHECKCLAUDE_MAX_INVESTIGATORS=4
CHECKCLAUDE_TIMEOUT_SECONDS=480

# --- X -----------------------------------------------------------------------
BOT_HANDLE=CheckClaude

# Reads (app-only)
X_BEARER_TOKEN=

# Writes (OAuth 1.0a user context, from the bot account's app)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# "poll" works on every access tier. "stream" (filtered stream) needs Pro/Enterprise.
INGEST_MODE=poll
POLL_SECONDS=30

# --- DMs ---------------------------------------------------------------------
# Also answer fact-check requests sent as DMs. A DM is answered in that DM and
# nowhere else. Needs dm.read + dm.write on the bot account's app.
CHECKCLAUDE_DM=true
DM_POLL_SECONDS=60
# X allows 10,000 characters in a DM, which is where the unabridged answer goes.
MAX_DM_CHARS=10000
# If a public answer won't fit even the thread, DM the full version to whoever
# asked. The public reply only mentions it if the DM actually arrives.
CHECKCLAUDE_DM_OVERFLOW=true

# --- Response ----------------------------------------------------------------
# "conversational" replies in plain prose, the way a person answers in a thread.
# "card" uses the labelled ✅/⚠️/❌ verdict format instead.
REPLY_STYLE=conversational

# 280 for a standard account; 25000 if the bot account has Premium.
MAX_POST_CHARS=280
THREAD_DEPTH=3

# Post an answer worth more than one post as a numbered self-reply thread rather
# than cutting it down to fit. "false" restores the single-post behaviour.
CHECKCLAUDE_THREAD_REPLIES=true
CHECKCLAUDE_MAX_THREAD_POSTS=4

# --- Ops ---------------------------------------------------------------------
CHECKCLAUDE_DB=checkclaude.sqlite3
DRY_RUN=false
