# Repo-wide. Each project also has its own .gitignore for anything specific to it.
.env
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# macOS Finder metadata. Never useful in a repo, and easy to commit by accident
# from a directory that was opened in Finder.
.DS_Store

# Runtime logs. checkclaude/bot.log is deliberately kept for now — it is a
# captured run, not incidental output — so it is excepted rather than removed.
*.log
!checkclaude/bot.log
